# Backend HTTP server port.
SERVER_PORT=8080

# PostgreSQL settings used by docker-compose or local database initialization.
POSTGRES_DB=ai_resume_optimizer
POSTGRES_USER=dawn
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5433

# JDBC connection used by the Spring Boot backend.
DB_URL=jdbc:postgresql://localhost:5432/ai_resume_optimizer
DB_USERNAME=dawn
DB_PASSWORD=postgres

# JWT signing secret. Use a long random value in real local or deploy environments.
JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-chars

# OpenAI-compatible chat model settings. Current AI features use these values.
DASHSCOPE_API_KEY=your_api_key
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-flash
OPENAI_TEMPERATURE=0.2
OPENAI_TIMEOUT_SECONDS=90
OPENAI_MAX_TOKENS=4000

# OpenAI-compatible embedding service settings.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=Qwen3-Embedding-0.6B
EMBEDDING_DIMENSION=1024
EMBEDDING_TIMEOUT=30
EMBEDDING_MAX_INPUT_LENGTH=8192

# Single-process async task executor settings for Phase 4.
# These only configure the bounded Spring thread pool; business endpoints are migrated separately.
APP_ASYNC_CORE_POOL_SIZE=4
APP_ASYNC_MAX_POOL_SIZE=8
APP_ASYNC_QUEUE_CAPACITY=100
APP_ASYNC_THREAD_NAME_PREFIX=ai-resume-task-
APP_ASYNC_AWAIT_TERMINATION_SECONDS=30

# File storage settings. The current supported runtime storage type is local.
APP_STORAGE_TYPE=local
APP_STORAGE_LOCAL_BASE_DIR=uploads
# Backward-compatible legacy local storage variable. Prefer APP_STORAGE_LOCAL_BASE_DIR for new config.
LOCAL_STORAGE_BASE_DIR=uploads

# MinIO container settings for local development.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# MinIO application-side placeholders. Current app code only reserves these values;
# MinIO storage is not enabled until a MinioFileStorageService implementation is added.
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ai-resume-files
MINIO_PUBLIC_ENDPOINT=
